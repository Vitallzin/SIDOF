# Ambiente virtual e caches do Python
.venv/
__pycache__/
.pytest_cache/

# Dados gerados (podem ser recriados com a semente fixa)
dados_gerados/*
!dados_gerados/.gitkeep

# Faturas em PDF (podem ser reais): nunca vão para o repositório
*.pdf
# ...exceto a documentação do projeto
!documentos/*.pdf
.claude

# ...exceto os dados fictícios que alimentam o sistema (pedido do professor)
!dados_gerados/usuarios.csv
!dados_gerados/extrato.csv
!dados_gerados/verdade.csv
!dados_gerados/usuarios_verdade.csv
